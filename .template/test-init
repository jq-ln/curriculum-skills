#!/usr/bin/env bash
# Runs `init --test` on a scratch copy of HEAD, then checks what a Derived repo
# would see: every removal-set path gone, the manifest and version.txt at 0.0.0,
# and every other file byte-identical. The init-test job in ci.yml runs it.
# Init deletes it, with the rest of .template/. Needs git and jq. Written for
# Bash 3.2, macOS's /bin/bash.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
before=$scratch/before # HEAD as committed
after=$scratch/after   # HEAD after init --test
mkdir "$before" "$after"

# The tracked tree at HEAD, as in a fresh Derived repo; tar keeps it portable to macOS.
git archive HEAD | tar -xf - -C "$before"
git archive HEAD | tar -xf - -C "$after"
"$after/.github/scripts/init" --test

failures=0
fail() {
  echo "test-init: $1" >&2
  failures=$((failures + 1))
}

removal_set=()
while IFS= read -r path; do
  removal_set+=("$path")
done < <("$before/.github/scripts/init" --list)
for path in "${removal_set[@]}"; do
  if [[ -e $after/$path || -L $after/$path ]]; then
    fail "$path survived init"
  fi
done

if ! jq -e '. == {".": "0.0.0"}' "$after/.release-please-manifest.json" >/dev/null; then
  fail ".release-please-manifest.json isn't {\".\": \"0.0.0\"}"
fi
if [[ $(<"$after/version.txt") != 0.0.0 ]]; then
  fail "version.txt isn't 0.0.0"
fi

# is_reset <file>: exits 0 for the two files init rewrites, which are checked above.
is_reset() {
  [[ $1 == .release-please-manifest.json || $1 == version.txt ]]
}

# in_removal_set <file>: exits 0 if the file is a removal-set path or under one.
in_removal_set() {
  local path
  for path in "${removal_set[@]}"; do
    if [[ $1 == "$path" || $1 == "$path"/* ]]; then
      return 0
    fi
  done
  return 1
}

# list_files <dir>: prints every file and symlink under <dir>, relative to it, sorted.
list_files() {
  (cd "$1" && find . \( -type f -o -type l \) -print) | sed 's|^\./||' | LC_ALL=C sort
}

inherited=0
while IFS= read -r file; do
  if is_reset "$file" || in_removal_set "$file"; then
    continue
  fi
  inherited=$((inherited + 1))
  if ! cmp -s -- "$before/$file" "$after/$file"; then
    fail "$file changed or is missing"
  fi
done < <(list_files "$before")

# Init only deletes and resets, so the copy holds nothing new.
while IFS= read -r file; do
  fail "$file appeared"
done < <(LC_ALL=C comm -13 <(list_files "$before") <(list_files "$after"))

if ((failures > 0)); then
  echo "test-init: $failures check(s) failed" >&2
  exit 1
fi
echo "test-init: init removed ${#removal_set[@]} removal-set paths, reset the version and left $inherited inherited files unchanged"
