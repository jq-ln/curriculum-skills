#!/usr/bin/env bash
# Turns a fresh Derived repo into a clean one: deletes the Template-own paths
# below, resets the release version to 0.0.0, opens the "Set up this repo"
# issue from .template/setup.md, then commits and pushes. The init workflow
# runs it once, on the first push to main.
#
#   init          do all of the above; runs only in GitHub Actions
#   init --test   delete and reset only: no commit, push or issue; runs only
#                 outside a git work tree, such as test-init's scratch copy
#   init --list   print the removal set, one path per line
#
# Needs git and, without --test, gh. Written for Bash 3.2, macOS's /bin/bash.
set -euo pipefail

# The removal set: every Template-own path, and the only place it's listed.
removal_set=(
  .template
  .github/README.md
  .github/scripts/init
  .github/workflows/init.yml
  CHANGELOG.md
)

mode=${1:-}
case $mode in
  "" | --test) ;;
  --list)
    printf '%s\n' "${removal_set[@]}"
    exit 0
    ;;
  *)
    echo "usage: init [--test | --list]" >&2
    exit 2
    ;;
esac

# Found from the script's own path, so --test works on a copy that isn't a clone.
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)
cd "$root"

# Both modes delete the removal set from this checkout, so neither runs in a
# clone someone works in, such as the Template's.
if [[ $mode == --test ]]; then
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "init: --test runs only outside a git work tree; .template/test-init runs it on a scratch copy" >&2
    exit 1
  fi
elif [[ ${GITHUB_ACTIONS:-} != true ]]; then
  echo "init: runs only in the init workflow; use .template/test-init to try it" >&2
  exit 1
fi

if [[ -z $mode ]]; then
  # A run queued behind init's own, such as one for a second push, has nothing to do.
  git fetch -q origin +refs/heads/main:refs/remotes/origin/main
  if ! git cat-file -e origin/main:.github/workflows/init.yml 2>/dev/null; then
    echo "init: already ran on main, so nothing to do"
    exit 0
  fi
fi

# Read before .template/ goes. The first line is the issue title.
setup_md=$(<.template/setup.md)
title=${setup_md%%$'\n'*}
title=${title#\# }
body=${setup_md#*$'\n'}

rm -rf -- "${removal_set[@]}"
printf '{\n  ".": "0.0.0"\n}\n' >.release-please-manifest.json
# Reset, not deleted: release-please's `simple` strategy never creates a missing version.txt.
printf '0.0.0\n' >version.txt

if [[ $mode == --test ]]; then
  echo "init: test mode, so nothing committed and no issue opened"
  exit 0
fi

# Opened before the push deletes this workflow, so a failure here can be re-run.
# A re-run after a failed push finds the issue and doesn't open a second one.
# Listed, not searched: the search index lags new issues, so a queued run could miss it.
existing=$(gh issue list --state all --limit 1000 --json title --jq '.[].title')
if ! grep -Fqx -- "$title" <<<"$existing"; then
  gh issue create --title "$title" --body "$body"
fi

# Commits on top of the latest main, not the pushed commit, so a push made while
# init ran is kept. Only the index moves; the working tree holds init's result.
git reset -q origin/main
# --ignore-unmatch: CHANGELOG.md doesn't exist until the Template's first release.
git rm -r -q --cached --ignore-unmatch -- "${removal_set[@]}"
git add .release-please-manifest.json version.txt
git commit -q -m "chore: remove the Template-own content"
git push -q
