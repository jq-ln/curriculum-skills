#!/usr/bin/env bash
# Applies this repo's settings, labels and ruleset from code.
#
# Run it from anywhere in a clone with admin `gh` auth. It targets the repo
# behind the `origin` remote, or $GH_REPO (owner/name) if set, and prints the
# target before changing anything. It also sets gh's default repo in this
# clone to origin. It's idempotent: each item is reported as "changed" or
# "in place", and re-running it after editing .github/rulesets/main.json
# updates the live ruleset. It deletes GitHub's default labels only while no
# issue or PR uses them. Needs gh and jq.
set -euo pipefail

for tool in gh jq; do
  if ! command -v "$tool" >/dev/null; then
    echo "setup: $tool is required" >&2
    exit 1
  fi
done

root=$(git rev-parse --show-toplevel)
# shellcheck source=.github/scripts/repo.bash
source "$(dirname "$0")/repo.bash"
repo=$(resolve_repo setup) || exit 1
api="repos/$repo"
err=$(mktemp)
trap 'rm -f "$err"' EXIT
changes=0

if [[ $(gh api "$api" --jq .permissions.admin) != true ]]; then
  echo "setup: your gh account isn't an admin of $repo" >&2
  exit 1
fi
echo "setup: applying to $repo"
echo

# report <changed|in place|kept> <item>
report() {
  printf '%-9s %s\n' "$1" "$2"
  if [[ $1 == changed ]]; then
    changes=$((changes + 1))
  fi
}

# gh's default repo -----------------------------------------------------------
#
# Why the plain gh calls in docs/workflow/ need it is in
# docs/workflow/issues.md#tracker-operations. It's stored in this clone's git
# config, so it covers this clone and its worktrees only. It's always origin,
# even when $GH_REPO overrides the target. Setting it by remote name, then
# comparing, avoids matching origin's URL to owner/name here. It's
# best-effort, so an origin gh can't map to GitHub, such as with $GH_REPO set,
# doesn't stop the rest of setup.

if git remote get-url origin >/dev/null 2>&1; then
  before=$(gh repo set-default --view 2>/dev/null)
  if gh repo set-default origin >/dev/null 2>"$err"; then
    after=$(gh repo set-default --view)
    if [[ $before == "$after" ]]; then
      report "in place" "gh default repo $after"
    else
      report changed "gh default repo $after"
    fi
  else
    report kept "gh default repo (origin isn't a GitHub repo, run gh repo set-default by hand)"
  fi
else
  report kept "gh default repo (no origin remote, run gh repo set-default by hand)"
fi

# Settings --------------------------------------------------------------------

# sync_settings <endpoint> <method> <desired JSON object>
# Sends the whole object if any field differs, and reports each field.
sync_settings() {
  local endpoint=$1 method=$2 want=$3 diff status key
  diff=$(gh api "$endpoint" \
    | jq -c --argjson want "$want" '. as $live | $want | with_entries(select(.value != $live[.key]))')
  if [[ $diff != '{}' ]]; then
    gh api -X "$method" "$endpoint" --input - <<<"$want" >/dev/null
  fi
  while IFS=$'\t' read -r status key; do
    report "$status" "setting $key"
  done < <(jq -r --argjson diff "$diff" \
    'keys_unsorted[] as $k | "\(if $diff | has($k) then "changed" else "in place" end)\t\($k)"' <<<"$want")
}

sync_settings "$api" PATCH '{
  "allow_squash_merge": true,
  "allow_merge_commit": false,
  "allow_rebase_merge": false,
  "squash_merge_commit_title": "PR_TITLE",
  "squash_merge_commit_message": "PR_BODY",
  "delete_branch_on_merge": true,
  "allow_auto_merge": false,
  "allow_update_branch": true,
  "has_wiki": false,
  "has_projects": false,
  "has_discussions": false
}'

# can_approve_pull_request_reviews also lets Actions create PRs, which
# release-please needs.
sync_settings "$api/actions/permissions/workflow" PUT '{
  "default_workflow_permissions": "read",
  "can_approve_pull_request_reviews": true
}'

# 204 when alerts are on, 404 when they're off. Anything else is an error,
# reported with the status and gh's own message from that same call.
status=$(gh api -i "$api/vulnerability-alerts" 2>"$err" | head -n 1 | cut -d ' ' -f 2 || true)
case $status in
  204) report "in place" "setting dependabot alerts" ;;
  404)
    gh api -X PUT "$api/vulnerability-alerts" --silent
    report changed "setting dependabot alerts"
    ;;
  *)
    echo "setup: couldn't read dependabot alerts (HTTP status: ${status:-none})" >&2
    cat "$err" >&2
    exit 1
    ;;
esac

if [[ $(gh api "$api/automated-security-fixes" --jq .enabled) == true ]]; then
  report "in place" "setting dependabot security updates"
else
  gh api -X PUT "$api/automated-security-fixes" --silent
  report changed "setting dependabot security updates"
fi

# Labels ----------------------------------------------------------------------

labels='[
  {"name": "needs-triage", "color": "fbca04", "description": "Maintainer needs to evaluate this issue"},
  {"name": "needs-info", "color": "d876e3", "description": "Waiting on reporter for more information"},
  {"name": "ready-for-agent", "color": "0e8a16", "description": "Fully specified, ready for an AFK agent"},
  {"name": "ready-for-human", "color": "1d76db", "description": "Requires human implementation"}
]'

# GitHub's defaults for a new repo, deleted by name unless an issue or PR
# uses them, since deleting a label strips it from every issue for good.
# Every other label is left alone.
github_default_labels='["bug", "documentation", "duplicate", "enhancement", "good first issue", "help wanted", "invalid", "question", "wontfix"]'

live_labels=$(gh api --paginate "$api/labels?per_page=100" | jq -s 'add // []')

# live_label <name>: prints the live label as JSON, or nothing. Label names
# are case-insensitive on GitHub.
live_label() {
  jq -c --arg name "$1" \
    'map(select(.name | ascii_downcase == ($name | ascii_downcase))) | first // empty' <<<"$live_labels"
}

# label_endpoint <live label JSON>
label_endpoint() {
  echo "$api/labels/$(jq -r '.name | @uri' <<<"$1")"
}

while read -r want; do
  label=$(jq -r .name <<<"$want")
  live=$(live_label "$label")
  if [[ -z $live ]]; then
    gh api -X POST "$api/labels" --input - <<<"$want" >/dev/null
    report changed "label $label (created)"
  elif jq -e --argjson want "$want" '{name, color, description} == $want' <<<"$live" >/dev/null; then
    report "in place" "label $label"
  else
    gh api -X PATCH "$(label_endpoint "$live")" \
      --input - <<<"$(jq '{new_name: .name, color, description}' <<<"$want")" >/dev/null
    report changed "label $label (updated)"
  fi
done < <(jq -c '.[]' <<<"$labels")

while read -r label; do
  live=$(live_label "$label")
  if [[ -z $live ]]; then
    report "in place" "label $label (already deleted)"
  # The issues endpoint covers PRs too.
  elif [[ $(gh api "$api/issues?state=all&per_page=1&labels=$(jq -r '.name | @uri' <<<"$live")" --jq length) != 0 ]]; then
    report kept "label $label (in use, delete it by hand)"
  else
    gh api -X DELETE "$(label_endpoint "$live")" --silent
    report changed "label $label (deleted)"
  fi
done < <(jq -r '.[]' <<<"$github_default_labels")

# Ruleset ---------------------------------------------------------------------
#
# Last, because a private repo on GitHub Free can't have rulesets, and the
# settings and labels should still apply there.

# Fields a ruleset export carries that GitHub sets itself.
desired=$(jq 'del(.id, .node_id, .source, .source_type, ._links, .created_at, .updated_at, .current_user_can_bypass)' \
  "$root/.github/rulesets/main.json")
name=$(jq -r .name <<<"$desired")
target=$(jq -r .target <<<"$desired")
id=$(gh api --paginate "$api/rulesets?includes_parents=false" \
  | jq -rs --arg name "$name" --arg target "$target" \
    '[.[][] | select(.name == $name and .target == $target) | .id] | first // empty')

if [[ -z $id ]]; then
  gh api -X POST "$api/rulesets" --input - <<<"$desired" >/dev/null
  report changed "ruleset $name (created)"
# GitHub fills in defaults the file leaves out, so compare only the fields
# the file sets. Arrays GitHub may reorder are sorted on both sides first.
elif gh api "$api/rulesets/$id" | jq -e --argjson want "$desired" '
    def normalize:
      walk(if type == "array" and all(.[]; type != "object") then sort else . end)
      | .rules |= (sort_by(.type) | map(
          if .type == "required_status_checks"
          then .parameters.required_status_checks |= sort_by(.context)
          else . end))
      | if has("bypass_actors") then .bypass_actors |= sort_by(.actor_type, .actor_id) else . end;
    def project($d):
      if type == "object" and ($d | type) == "object" then
        with_entries(.key as $k | select($d | has($k)) | .value |= project($d[$k]))
      elif type == "array" and ($d | type) == "array" and length == ($d | length) then
        [range(length) as $i | .[$i] | project($d[$i])]
      else . end;
    ($want | normalize) as $want
    | normalize | project($want) == $want' >/dev/null; then
  report "in place" "ruleset $name"
else
  gh api -X PUT "$api/rulesets/$id" --input - <<<"$desired" >/dev/null
  report changed "ruleset $name (updated)"
fi

echo
if ((changes == 0)); then
  echo "setup: everything already in place"
else
  echo "setup: $changes changed"
fi
