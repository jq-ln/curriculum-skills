{
  "config": {
    // Body lines aren't wrapped, so line length isn't linted.
    "MD013": false,
    // GDScript is indented with tabs, so its examples keep them.
    "MD010": { "ignore_code_languages": ["gdscript"] }
  },
  "gitignore": true,
  "ignores": [
    // release-please writes the changelog, and repeats headings such as "Features" per release.
    "CHANGELOG.md",
    // The README's Claude Code symlink to .agents/skills, whose files are linted already.
    ".claude/skills/**",
    // Doc sets the build script's tests break on purpose, one check rule each.
    "tests/build-curriculum/fixtures/check/**"
  ]
}
